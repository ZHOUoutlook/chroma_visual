# 后端base_url 配置
VITE_API_BASE_URL=http://localhost:8010

# miner文档解析配置
MINERU_API_KEY=your_api_key_here
MINERU_API_BASE_URL=https://mineru.net
MINERU_POLL_TIMEOUT_SECONDS=90
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_TRUST_ENV=false
MINERU_DATA_DIR=./data/mineru
MINERU_META_DIR=./data/mineru_meta
MINERU_ASSETS_DIR=./data/mineru_assets
UPLOAD_DIR=./data/uploads

# 嵌入模型
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_BASE_URL=http://localhost:3000
EMBEDDING_API_KEY=sk-your-key

# 向量数据库配置 
## 不配 CHROMA_HOST/CHROMA_PORT 时自动使用本地客户端模式（PersistentClient）
## CHROMA_DB_PATH 仅在未配置 CHROMA_HOST 和 CHROMA_PORT 时生效
CHROMA_DB_PATH=./chroma_db
CHROMA_HOST=your—host
CHROMA_PORT=your—host-port